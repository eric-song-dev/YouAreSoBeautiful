{
  "name": "dsh-beauty-dive-progress",
  "version": "2.1.0",
  "private": true,
  "description": "beauty-dive-progress · 深潜进度桌宠 —— DeepSeek Harness 永久插件：在 DSH Deep diving 回答期间，用坤宠动图填满深潜状态行下方区块，进度 0%→100%，每 20% 切换动作与文案，完成时系统级播放提示音",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "deep-dive",
    "progress",
    "kun",
    "桌宠"
  ],
  "license": "MIT",
  "main": "./lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "assets",
    "docs",
    "demo",
    "scripts",
    "beauty.package.json"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "test": "node scripts/validate.mjs",
    "demo": "npx --yes serve ."
  }
}
